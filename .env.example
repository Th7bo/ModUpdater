# PostgreSQL connection string
DATABASE_URL=postgresql://modupdater:modupdater@localhost:5432/modupdater

# Auth.js session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Discord OAuth credentials — create at https://discord.com/developers/applications
# Under OAuth2, add redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Discord bot token — from the same application's Bot section
DISCORD_BOT_TOKEN=your-discord-bot-token

# Max parallel Gradle builds (default: 2)
BUILD_CONCURRENCY=2

# Build debounce delay in milliseconds (default: 60000 = 1 minute)
DEBOUNCE_MS=60000

# Directory for generated SSH key pairs (default: ./data/keys)
SSH_KEYS_DIR=./data/keys

# Directory for local git repo clones (default: ./data/repos)
REPOS_DIR=./data/repos

# Directory for build and sync activity logs (default: ./data/logs)
LOG_DIR=./data/logs

# Directory for build artifacts (default: ./data/artifacts)
ARTIFACTS_DIR=./data/artifacts

# Base URL for artifact download links (default: http://localhost:3000)
BASE_URL=http://localhost:3000

# Default Discord channel ID for notifications — optional fallback
DEFAULT_DISCORD_CHANNEL_ID=

# Default polling interval in milliseconds (default: 900000 = 15 minutes)
DEFAULT_POLLING_INTERVAL_MS=900000
