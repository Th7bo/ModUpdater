FROM node:22-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@11

# Install JDKs and git for builds
RUN apk add --no-cache openjdk21-jdk git openssh-client

# Default JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk

EXPOSE 3000

# Install dependencies and start dev server
# Using entrypoint script to handle npm install on mount
CMD ["sh", "-c", "pnpm install && pnpm dev"]
